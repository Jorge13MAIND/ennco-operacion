# Public application
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dedicated ENNCO Supabase project. Never use a shared Teckel project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_ENNCO_ORGANIZATION_ID=

# Service-role credentials belong only in a separately controlled worker.
# They must never be exposed to the browser or required by this web application.

# Feature gates. Production defaults are fail closed.
ENNCO_ALLOW_EXTERNAL_SEND=false
ENNCO_GLOBAL_KILL_SWITCH=true
ENNCO_PUBLIC_SURFACE_RELEASED=false
ENNCO_PUBLIC_SURFACE_RELEASED_AT=
ENNCO_PRIVACY_NOTICE_APPROVED=false
ENNCO_PRIVACY_NOTICE_APPROVED_VERSION=
ENNCO_PRIVACY_NOTICE_APPROVED_SHA256=
ENNCO_GMAIL_WEBHOOK_RELEASED=false
ENNCO_GMAIL_OAUTH_RELEASED=false
ENNCO_ASSISTANT_RELEASED=false
ENNCO_UNSUBSCRIBE_RELEASED=false
ENNCO_DEMO_MODE=true
ENNCO_REQUIRE_MFA=false

# Dispatch engine (M32). Fail closed: released requires dedicated Supabase,
# no demo, CRON_SECRET and ENNCO_DISPATCH_SECRET. Mode "shadow" only creates
# DRY_RUN messages; "live" additionally requires the Gmail OAuth, Gmail
# webhook and unsubscribe releases.
ENNCO_DISPATCH_RELEASED=false
ENNCO_DISPATCH_MODE=shadow
# Server-only HMAC proof secret, mirrored in app.private_runtime_config.
ENNCO_DISPATCH_SECRET=
# Vercel Cron bearer secret (Vercel injects Authorization: Bearer $CRON_SECRET).
CRON_SECRET=

# Server-only HMAC keys. Use independent random values of at least 32 characters.
# Seed the matching ingest secret in the private database config during an approved rollout.
ENNCO_PREQUOTE_INGEST_SECRET=
ENNCO_PDF_SIGNING_SECRET=
ENNCO_GMAIL_INGEST_SECRET=
ENNCO_GMAIL_OAUTH_STATE_SECRET=
ENNCO_GMAIL_OAUTH_COMPLETION_SECRET=
ENNCO_UNSUBSCRIBE_SIGNING_SECRET=
ENNCO_UNSUBSCRIBE_INGEST_SECRET=

# Apollo REST API. Server or controlled worker only. Never expose as NEXT_PUBLIC_*.
# The key must start with read-only scopes for profile, email accounts and saved-contact search.
APOLLO_API_KEY=
APOLLO_EXPECTED_PROFILE_NAME=Francisco Cuellar
APOLLO_EXPECTED_PROFILE_EMAIL=francisco.cuellar@ennco.com.mx
# Leave empty until the two domains and three exact isolated mailboxes are frozen.
APOLLO_EXPECTED_MAILBOXES=
APOLLO_RESEARCH_CREDIT_CAP=500

# Other providers.
RESEND_API_KEY=
SENTRY_DSN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_CLOUD_PROJECT=
GOOGLE_KMS_KEY_NAME=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT=
GMAIL_PUBSUB_SUBSCRIPTION=
