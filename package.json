{
  "name": "ennco-revenue-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "verify:performance:smoke": "node scripts/performance-gate.mjs --duration-seconds 10 --rps 20 --p95-budget-ms 500 --max-error-rate 0",
    "verify:performance:full": "node scripts/performance-gate.mjs --duration-seconds 300 --rps 20 --p95-budget-ms 500 --max-error-rate 0",
    "import:data": "node scripts/import-ennco-sources.mjs --repo .",
    "verify:data": "node scripts/verify-data-imports.mjs --repo . && node scripts/build-research-seed-batch.mjs --repo . --check",
    "build:research-seed": "node scripts/build-research-seed-batch.mjs --repo .",
    "verify:research-seed": "node scripts/build-research-seed-batch.mjs --repo . --check",
    "capture:data-verification": "node scripts/verify-data-imports.mjs --repo . --write-evidence",
    "verify:rtm": "node scripts/verify-rtm.mjs .",
    "verify:secrets": "node scripts/verify-no-secrets.mjs",
    "verify:scope": "node scripts/verify-scope-boundaries.mjs .",
    "verify:api-surface": "node scripts/verify-api-surface.mjs .",
    "verify:db": "supabase/tests/run-core-gate.sh",
    "verify:storage": "supabase/tests/run-storage-gate.sh",
    "verify:retention": "supabase/tests/run-retention-gate.sh",
    "verify:prequote-db": "supabase/tests/run-prequote-gate.sh",
    "verify:analytics-db": "supabase/tests/run-analytics-gate.sh",
    "verify:gmail-db": "supabase/tests/run-gmail-operations-gate.sh",
    "verify:canary-db": "supabase/tests/run-shadow-canary-gate.sh",
    "verify:campaign": "node scripts/verify-campaign-package.mjs --repo .",
    "verify:m5-canary": "node --experimental-strip-types scripts/m5-shadow-canary.mts --repo .",
    "capture:m5-evidence": "node scripts/verify-campaign-package.mjs --repo . --write-evidence && node --experimental-strip-types scripts/m5-shadow-canary.mts --repo . --write-evidence",
    "capture:m5-browser": "node scripts/capture-m5-browser-evidence.mjs --repo .",
    "verify:m6-readiness": "node scripts/verify-first-send-readiness.mjs --repo .",
    "capture:m6-evidence": "node scripts/verify-first-send-readiness.mjs --repo . --write-evidence",
    "capture:m6-browser": "node scripts/capture-m6-browser-evidence.mjs --repo .",
    "verify:first-send-db": "supabase/tests/run-first-send-release-gate.sh",
    "verify:scaling-db": "supabase/tests/run-controlled-scaling-gate.sh",
    "verify:monthly-reporting-db": "supabase/tests/run-contractual-monthly-reporting-gate.sh",
    "verify:handoff-db": "supabase/tests/run-handoff-acceptance-gate.sh",
    "verify:security-consistency-db": "supabase/tests/run-security-consistency-gate.sh",
    "verify:unsubscribe-db": "supabase/tests/run-one-click-unsubscribe-gate.sh",
    "verify:commercial-integrity-db": "supabase/tests/run-commercial-integrity-gate.sh",
    "verify:commercial-operations-db": "supabase/tests/run-canonical-commercial-operations-gate.sh",
    "verify:strict-lead-suppression-db": "supabase/tests/run-strict-lead-suppression-gate.sh",
    "verify:capacity-db": "supabase/tests/run-monthly-operational-capacity-gate.sh",
    "verify:research-db": "supabase/tests/run-research-workbench-gate.sh",
    "verify:suppression-privacy-db": "supabase/tests/run-suppression-privacy-gate.sh",
    "verify:m8-readiness": "node --experimental-strip-types scripts/m8-contractual-reporting.mts --repo .",
    "capture:m8-evidence": "node --experimental-strip-types scripts/m8-contractual-reporting.mts --repo . --write-evidence",
    "capture:m8-browser": "node scripts/capture-m8-browser-evidence.mjs --repo .",
    "verify:m9-readiness": "node --experimental-strip-types scripts/m9-handoff-readiness.mts --repo .",
    "test:m9-package": "node --experimental-strip-types scripts/m9-handoff-readiness.mts --repo . --self-test",
    "capture:m9-provisional": "node --experimental-strip-types scripts/m9-handoff-readiness.mts --repo . --write-provisional",
    "capture:m9-final": "node --experimental-strip-types scripts/m9-handoff-readiness.mts --repo . --freeze-final",
    "capture:m9-evidence": "npm run capture:m9-provisional",
    "capture:m9-browser": "node scripts/capture-m9-browser-evidence.mjs --repo .",
    "verify:m7-readiness": "node --experimental-strip-types scripts/m7-controlled-scaling.mts --repo .",
    "capture:m7-evidence": "node --experimental-strip-types scripts/m7-controlled-scaling.mts --repo . --write-evidence",
    "capture:m7-browser": "node scripts/capture-m7-browser-evidence.mjs --repo .",
    "verify:prequote-model": "node scripts/verify-prequote-model.mjs --repo .",
    "verify:restore": "bash scripts/m2-verify-local-recovery.sh",
    "capture:m2-restore": "bash scripts/m2-local-backup-restore-drill.sh --repo . --evidence-dir ./evidence/m2-restore && bash scripts/m2-verify-restore-evidence.sh --repo . --evidence-dir ./evidence/m2-restore",
    "capture:m9-restore": "bash scripts/m2-local-backup-restore-drill.sh --repo . --evidence-dir ./evidence/m9-restore && bash scripts/m2-verify-restore-evidence.sh --repo . --evidence-dir ./evidence/m9-restore",
    "verify:m9-restore": "bash scripts/m2-verify-restore-evidence.sh --repo . --evidence-dir ./evidence/m9-restore",
    "verify:audit": "npm audit --audit-level=high",
    "sbom": "npm sbom --sbom-format cyclonedx",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:m0m1": "npm run verify:rtm && npm run verify:data && npm run verify:db && npm run verify && npm run test:e2e",
    "verify:m2": "npm run verify:rtm && npm run verify:data && npm run verify:secrets && npm run verify:db && npm run verify:storage && npm run verify:retention && npm run verify:restore && npm run verify:audit && npm run verify && npm run test:e2e",
    "verify:m3": "npm run verify:rtm && npm run verify:data && npm run verify:secrets && npm run verify:prequote-model && npm run verify:db && npm run verify:storage && npm run verify:retention && npm run verify:prequote-db && npm run verify:analytics-db && npm run verify:restore && npm run verify:audit && npm run verify && npm run test:e2e",
    "verify:m4": "npm run verify:rtm && npm run verify:data && npm run verify:secrets && npm run verify:api-surface && npm run verify:prequote-model && npm run verify:db && npm run verify:storage && npm run verify:retention && npm run verify:prequote-db && npm run verify:analytics-db && npm run verify:gmail-db && npm run verify:capacity-db && npm run verify:research-db && npm run verify:restore && npm run verify:audit && npm run verify && npm run test:e2e",
    "verify:m5": "npm run verify:rtm && npm run verify:data && npm run verify:secrets && npm run verify:campaign && npm run verify:m5-canary && npm run verify:db && npm run verify:storage && npm run verify:retention && npm run verify:prequote-db && npm run verify:analytics-db && npm run verify:gmail-db && npm run verify:canary-db && npm run verify:restore && npm run verify:audit && npm run verify && npm run test:e2e",
    "verify:m6": "npm run verify:m5 && npm run verify:m6-readiness && npm run verify:first-send-db",
    "verify:m7": "npm run verify:m6 && npm run verify:m7-readiness && npm run verify:scaling-db",
    "verify:m8": "npm run verify:m7 && npm run verify:m8-readiness && npm run verify:monthly-reporting-db",
    "verify:m9": "npm run verify:m8 && npm run verify:scope && npm run verify:security-consistency-db && npm run verify:unsubscribe-db && npm run verify:commercial-integrity-db && npm run verify:suppression-privacy-db && npm run verify:commercial-operations-db && npm run verify:strict-lead-suppression-db && npm run verify:a11y && npm run verify:m9-restore && npm run verify:m9-readiness && npm run verify:handoff-db"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "google-auth-library": "^10.3.0",
    "next": "16.3.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
